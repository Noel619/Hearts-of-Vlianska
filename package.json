{
  "name": "hearts-of-vlianska",
  "private": true,
  "version": "1.0.0",
  "description": "Gran estrategia al estilo Hearts of Iron IV en el metro de Vlianska, 2033.",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "node scripts/gen-icons.mjs && vite",
    "build": "node scripts/gen-icons.mjs && tsc --noEmit && vite build",
    "build:single": "node scripts/gen-icons.mjs && tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vitest run tests/simulation.test.ts --disableConsoleIntercept"
  },
  "dependencies": {
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/pt-mono": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-sans-narrow": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
