{
  "name": "sombras-de-vlianska",
  "private": true,
  "version": "0.1.0",
  "description": "RPG de escuadra y supervivencia en mundo abierto, en 3D, ambientado en el metro de Vlianska.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/pt-mono": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-sans-narrow": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
